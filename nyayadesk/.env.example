# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://app.nyayadesk.in
DATA_DIR=/data
COOKIE_SECURE=1

# ── AI (required for live answers; blank = demo mode) ───
ANTHROPIC_API_KEY=
# Premium model: Solo, Chambers, Firm and trial plans.
NYAYA_MODEL=claude-opus-5
# Standard model: the ₹999 Starter plan. Compare models first: npm run compare
NYAYA_MODEL_STANDARD=claude-sonnet-5
# Server-side refusal fallback to Anthropic's recommended model. "off" to disable.
NYAYA_FALLBACKS=default

# ── Data protection ─────────────────────────────────────
UPLOAD_MAX_MB=25
UPLOAD_RETENTION_DAYS=30
SESSION_DAYS=14

# ── Billing: Razorpay (blank = invoice billing only) ────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs from the Razorpay dashboard. Amount per unit = seat price INCLUDING 18% GST:
# Starter ₹1,178.82 · Solo ₹3,538.82 · Chambers ₹7,078.82 · Firm ₹11,798.82
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_CHAMBERS=
RAZORPAY_PLAN_FIRM=

# ── Seller details on GST invoices ──────────────────────
COMPANY_NAME=NyayaDesk Technologies Pvt. Ltd.
COMPANY_GSTIN=
COMPANY_ADDRESS=
# Two-digit GST state code of your registered office (e.g. 27 Maharashtra, 07 Delhi, 29 Karnataka)
COMPANY_STATE_CODE=
SUPPORT_EMAIL=support@nyayadesk.in
